# Copy to a file outside the repo or export these in the shell.
# Do not commit real hostnames or private keys.

# user@host, or a Host alias from ~/.ssh/config
YARPGEN_SSH_TARGET=user@example.com

# Optional. When empty, ssh uses the agent / default keys.
YARPGEN_SSH_KEY=

# Directory on the remote machine. Created if missing.
YARPGEN_REMOTE_DIR=/var/tmp/yarpgen-campaign

# Passed through to the worker. Examples: 30s, 12h, 7d is not parsed; use hours.
YARPGEN_DURATION=24h

# Optional path to a campaign JSON config. Defaults to campaign/example-config.json.
YARPGEN_CONFIG=campaign/example-config.json

# Extra ssh options, for example: -p 2222
YARPGEN_SSH_EXTRA=
